=== Makefile ===
# E4 一键命令（BuildChecker）。每次执行 make 生成新的 work/<时间>/，不覆盖旧记录。
SHELL      := /bin/bash
SERVICE    := buildchecker
STUDENT_ID := $(or $(shell git config user.name 2>/dev/null),local)
IMAGE      := e4-$(SERVICE):$(STUDENT_ID)
STAMP      := $(shell date +%Y%m%d-%H%M%S)
RUN        := work/$(STAMP)
TIMEOUT    := 600
BASE_IMAGE := $(shell sed -n 's/^ARG BASE_IMAGE=//p' services/$(SERVICE)/Dockerfile)
export STUDENT_ID
COMPOSE    := docker compose -p e4-$(SERVICE)-$(shell echo $(STUDENT_ID) | tr A-Z a-z)

.PHONY: all doctor build test smoke scan shell lock clean

all: doctor build test smoke scan
	@echo "证据目录：$(RUN)"

$(RUN):
	@mkdir -p $(RUN)

.env:
	cp .env.example .env && chmod 600 .env
	@echo "已从 .env.example 生成 .env（权限 600），需要时再填写。"

doctor: | $(RUN)
	python3 scripts/doctor.py --out $(RUN)/env.json

build: .env | $(RUN)
	$(COMPOSE) build --progress=plain 2>&1 | tee $(RUN)/build.log; test $${PIPESTATUS[0]} -eq 0
	docker image inspect $(IMAGE) --format '{"image":"$(IMAGE)","id":"{{.Id}}","arch":"{{.Architecture}}","created":"{{.Created}}"}' | tee $(RUN)/image.json
	$(COMPOSE) run --rm --no-deps $(SERVICE) cat /opt/toolchain.lock | tee $(RUN)/toolchain.lock

test: .env | $(RUN)
	timeout $(TIMEOUT) $(COMPOSE) run --rm -T --interactive=false $(SERVICE) python3 -m pytest 2>&1 | tee $(RUN)/test.log; test $${PIPESTATUS[0]} -eq 0

smoke: .env | $(RUN)
	timeout $(TIMEOUT) $(COMPOSE) run --rm -T --interactive=false $(SERVICE) python3 -m $(SERVICE) smoke | tee $(RUN)/smoke.json; test $${PIPESTATUS[0]} -eq 0

scan: | $(RUN)
	python3 scripts/secret_scan.py . --history --image $(IMAGE) | tee $(RUN)/secret-scan.txt; test $${PIPESTATUS[0]} -eq 0

shell: .env
	@mkdir -p work
	$(COMPOSE) run --rm --user $$(id -u):$$(id -g) -e HOME=/tmp -v "$$PWD/work:/app/work" $(SERVICE) bash

lock:
	docker run --rm --user $$(id -u):$$(id -g) -e HOME=/tmp -v "$$PWD":/src -w /src $(BASE_IMAGE) sh -c '\
	  python3 -m venv /tmp/v && /tmp/v/bin/pip install -q uv==0.12.19 && \
	  /tmp/v/bin/uv pip compile requirements-dev.in --generate-hashes --python-version 3.13 --python-platform linux -o requirements-dev.lock'

clean:
	-docker image rm $(IMAGE)
=== compose ===
# 用法：make build / make test / make smoke（Makefile 会设置 STUDENT_ID 和项目名）
# 也可以直接：STUDENT_ID=<学号> docker compose run --rm buildchecker pytest
services:
  buildchecker:
    build:
      context: .
      dockerfile: services/buildchecker/Dockerfile
    image: e4-buildchecker:${STUDENT_ID:-local}
    network_mode: none
    cpus: 2
    mem_limit: 1g
    pids_limit: 256
    cap_add:
      - SYS_PTRACE
    security_opt:
      - no-new-privileges:true
=== Dockerfile ===
# BuildChecker 服务镜像（A 组）。构建上下文是仓库根目录。
# 基础镜像按 digest 固定；系统工具与 Python 包版本写入 /opt/toolchain.lock；服务以普通用户运行。
ARG BASE_IMAGE=m.daocloud.io/docker.io/library/python@sha256:f82c96458eedc847b233e582eb31336f4954b39cae020b6dcf5b3ed0e5cbcd74
FROM ${BASE_IMAGE}

# 课程阿里云 ECS 到 Debian 官方源可能长时间无进展；镜像站内容仍由 apt 签名校验。
ARG DEBIAN_MIRROR=https://mirrors.aliyun.com

ENV LC_ALL=C.UTF-8 \
    TZ=UTC \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN sed -i \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_MIRROR}/debian-security|g" \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}/debian|g" \
      /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends gcc make libc6-dev strace git \
 && rm -rf /var/lib/apt/lists/* \
 && dpkg-query -W -f='${Package}=${Version}\n' gcc make libc6-dev strace git > /opt/toolchain.lock \
 && echo "python3=$(python3 -c 'import platform; print(platform.python_version())')" >> /opt/toolchain.lock \
 && echo "arch=$(dpkg --print-architecture)" >> /opt/toolchain.lock

COPY requirements-dev.lock /tmp/requirements-dev.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements-dev.lock \
 && pip freeze | sed 's/^/pip:/' >> /opt/toolchain.lock

RUN useradd --create-home --uid 10001 app && install -d -o app -g app /app
WORKDIR /app
COPY --chown=app:app services/buildchecker/ /app/
COPY --chown=app:app fixtures/ /app/fixtures/
USER app

CMD ["python3", "-m", "buildchecker", "--help"]
